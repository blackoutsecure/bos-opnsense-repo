.secrets/
secrets.*
!SECRETS.md
*.pem
*.key
*.crt
*.p12
*.pfx

# Native build outputs and generated package repositories.
/build/
/dist/
/artifacts/
*.pkg
*.txz
*.tzst
*.tar
*.tar.gz

# Local logs and operating-system files.
*.log
.DS_Store
Thumbs.db
